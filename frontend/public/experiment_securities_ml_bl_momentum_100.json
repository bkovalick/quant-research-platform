{
  "_description": "ML+BL momentum experiment on 100-stock sector-balanced universe. Trimmed version of full_universe config for faster iteration.",
  "database_name": "research.duckdb",
  "market_store_config": {
    "start_date": "2023-01-01",
    "end_date": "2026-10-22",
    "data_source": {
      "yfinance": null
    },
    "benchmark": "SPY",
    "risk_free_rate": 0.03,
    "transaction_cost": 0.003,
    "apply_market_caps": false,
    "historical_sp500_tickers_path": "data/S&P 500 Historical Components & Changes.csv",
    "tickers": [
      "AGG",
      "LQD",
      "^VIX"
    ]
  },
  "strategies": [
    {
      "name": "securities_ml_bl_momentum_100",
      "market_state_config": {
        "lookback_window_key": "1y",
        "market_frequency": "d",
        "cash_allocation": 0.005,
        "exogenous_tickers": [
          "^VIX"
        ],
        "investment_universe": [
          "AGG",
          "LQD"
        ],
        "include_sp500_members": true
      },
      "signals_config": {
        "apply_winsorizing": true,
        "windsor_percentiles": {
          "lower": 0.05,
          "upper": 0.95
        },
        "mean_reversion_window": 4,
        "momentum_skip_periods": 4,
        "black_litterman": {
          "delta": 2.5,
          "tau": 0.05,
          "reversion_view": 0.03,
          "ml_view_spread": 0.03,
          "view_direction": "momentum"
        },
        "ml_signals_config": {
          "enabled": true,
          "features_model": "cross_sectional_model",
          "features": [
            "mom_1m",
            "mom_12m",
            "vol_1m",
            "vol_3m",
            "reversal",
            "mom_x_vol_regime",
            "reversal_x_vol_regime",
            "max_return",
            "high_52w",
            "beta_1m",
            "beta_1y",
            "idiosyncratic_vol"
          ],
          "signals_model": "ridge",
          "training_window": "2y",
          "horizon": "1m",
          "alpha": 1.0,
          "rebal_cadence": "1m",
          "sample_stride": "1w"
        }
      },
      "rebalance_problem": {
        "optimizer_type": "portfolio_optimizer",
        "rebalance_frequency": "weekly",
        "strategy_rules": {
          "vol_target": 0.15,
          "vol_lookback_days": "1m",
          "vol_max_leverage": 1.5
        },
        "constraints": {
          "concentration_strength": 1,
          "risk_aversion": 1.0,
          "turnover_limit": 1.0,
          "min_position_size": 0.0,
          "max_position_size": 0.05,
          "max_positions": 80,
          "asset_class_constraints": {
            "Equity": [
              0.75,
              0.95
            ],
            "Fixed Income": [
              0.03,
              0.2
            ]
          },
          "sector_constraints": {
            "Information Technology": [
              0.06,
              0.28
            ],
            "Health Care": [
              0.05,
              0.18
            ],
            "Financials": [
              0.05,
              0.18
            ],
            "Consumer Discretionary": [
              0.04,
              0.14
            ],
            "Industrials": [
              0.05,
              0.16
            ],
            "Consumer Staples": [
              0.03,
              0.1
            ],
            "Communication Services": [
              0.02,
              0.12
            ],
            "Energy": [
              0.02,
              0.08
            ],
            "Utilities": [
              0.02,
              0.08
            ],
            "Materials": [
              0.02,
              0.08
            ],
            "Real Estate": [
              0.02,
              0.07
            ]
          }
        },
        "strategy_type": "systematic_strategy",
        "signal_source": "black_litterman"
      }
    }
  ]
}
