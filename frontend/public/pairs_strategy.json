{
  "_description": "Run a basic Pairs Trading Strategy",
  "database_name": "research.duckdb",
  "market_store_config": {
    "start_date": "2023-01-01",
    "end_date": "2026-07-08",
    "data_source": {
      "yfinance": null
    },
    "benchmark": "SPY",
    "risk_free_rate": 0.03,
    "transaction_cost": 0.005,
    "apply_market_caps": false,
    "historical_sp500_tickers_path": "data/S&P 500 Historical Components & Changes.csv",
    "tickers": [
      "TFC",
      "ZION",
      "^VIX"
    ]
  },
  "strategies": [
    {
      "name": "pairs_trading_strat",
      "market_state_config": {
        "lookback_window_key": "2m",
        "market_frequency": "d",
        "cash_allocation": 1.0,
        "exogenous_tickers": [
          "^VIX"
        ],
        "investment_universe": [
          "TFC",
          "ZION"
        ],
        "include_sp500_members": false
      },
      "signals_config": {
        "pairs_trading": {
          "pairs_lookback_horizon": 20,
          "cointegration_threshold": 0.05,
          "correlation_filter": 0.7,
          "pairs_entry": 1.25,
          "pairs_exit": 0.5,
          "pairs_stop_loss": 3.5
        }
      },
      "rebalance_problem": {
        "optimizer_type": "None",
        "rebalance_frequency": "daily",
        "strategy_type": "pairs_trading_strategy",
        "signal_source": "pairs_trading",
        "monitoring_type": "pairs"
      }
    }
  ]
}
