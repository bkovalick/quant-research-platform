{
  "_description": "ML signal cadence test (ridge, ML scores feed the Black-Litterman view, long the top-scored quintile). 1: baseline, monthly scores traded weekly. 2 and 3: retrain cadence in sync with the strategy rebalance, weekly and monthly. 4 and 5: the same two with a 5y training window. Everything else is identical. Compare on mean IC and IC t-stat first, returns second. Data ends 2021-12-31; 2022 onward is held out.",
  "database_name": "research.duckdb",
  "market_store_config": {
    "start_date": "2000-01-01",
    "end_date": "2026-11-12",
    "data_source": {
      "yfinance": null
    },
    "benchmark": "SPY",
    "risk_free_rate": 0.03,
    "transaction_cost": 0.003,
    "apply_market_caps": false,
    "historical_sp500_tickers_path": "data/S&P 500 Historical Components & Changes.csv",
    "tickers": [
      "AGG",
      "LQD",
      "^VIX"
    ]
  },
  "strategies": [
    {
      "name": "ml_cadence_1_baseline_3y_h2w_cad1m_rebal_weekly",
      "market_state_config": {
        "lookback_window_key": "1y",
        "market_frequency": "d",
        "cash_allocation": 0.005,
        "exogenous_tickers": [
          "^VIX"
        ],
        "investment_universe": [
          "AGG",
          "LQD"
        ],
        "include_sp500_members": true
      },
      "signals_config": {
        "apply_winsorizing": true,
        "windsor_percentiles": {
          "lower": 0.05,
          "upper": 0.95
        },
        "mean_reversion_window": 4,
        "momentum_skip_periods": 4,
        "black_litterman": {
          "delta": 2.5,
          "view_uncertainty": 1.0,
          "reversion_view": 0.03,
          "ml_view_spread": 0.03,
          "view_direction": "momentum"
        },
        "ml_signals_config": {
          "enabled": true,
          "features_model": "cross_sectional_model",
          "features": [
            "vol_3m",
            "reversal",
            "mom_x_vol_regime",
            "reversal_x_vol_regime",
            "max_return",
            "high_52w",
            "idiosyncratic_vol"
          ],
          "signals_model": "ridge",
          "training_window": "3y",
          "horizon": "2w",
          "alpha": 1.0,
          "rebal_cadence": "1m",
          "sample_stride": "1w",
          "max_depth": 3,
          "n_estimators": 100,
          "learning_rate": 0.05
        }
      },
      "rebalance_problem": {
        "optimizer_type": "parameterized_optimizer",
        "rebalance_frequency": "weekly",
        "apply_tax_objective": false,
        "strategy_rules": {
          "vol_target": 0.15,
          "vol_lookback_days": "1m",
          "vol_max_leverage": 1.5
        },
        "constraints": {
          "concentration_strength": 1,
          "risk_aversion": 1.0,
          "turnover_limit": 1.0,
          "min_position_size": 0.0,
          "max_position_size": 0.1,
          "asset_class_constraints": {
